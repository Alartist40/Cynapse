[package]
name = "cynapse-core"
version = "0.1.0"
edition = "2024"
description = "Core library for cynapse: config, DENDRITE memory, sessions, agent loop, providers, tools."
license = "MIT"

[dependencies]
anyhow = "1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_yaml = "0.9"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "time", "fs", "io-util", "process", "sync"] }
rusqlite = { version = "0.32", features = ["bundled"] }
regex = "1"
chrono = "0.4"
dirs = "5"
uuid = { version = "1", features = ["v4"] }
indicatif = "0.17"
reqwest = { version = "0.12", default-features = false, features = ["rustls-tls", "stream", "json", "blocking"] }
futures-util = "0.3"
thiserror = "2"
async-trait = "0.1"
sha2 = "0.10"
base64 = "0.22"
url = "2"
axum = { version = "0.7", features = ["multipart"] }
tower = "0.4"
async-stream = "0.3"
leafcutter = { path = "../../leafcutter", features = ["llama-ffi"] }

[features]
default = []
anthropic = []

[dev-dependencies]
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
